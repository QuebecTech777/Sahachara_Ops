# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel Deployment)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Backend Render service endpoint (e.g., https://sahachara-backend.onrender.com)
# Leave empty during local development to use the integrated dev server proxy
VITE_API_BASE_URL=""

# VITE_SUPABASE_URL: Project URL from Supabase dashboard (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Client-side publishable key from Supabase Project Settings -> API
VITE_SUPABASE_ANON_KEY=""

# Frontend Observability: New Relic Browser Agent (Public Client Configuration)
VITE_NEW_RELIC_LICENSE_KEY=""
VITE_NEW_RELIC_APPLICATION_ID=""
VITE_NEW_RELIC_ACCOUNT_ID=""
# Regional Beacon (defaults to bam.eu01.nr-data.net for EU region accounts)
VITE_NEW_RELIC_BEACON="bam.eu01.nr-data.net"

# Frontend Observability: Better Stack Frontend Error Logging (Public Token)
VITE_BETTER_STACK_SOURCE_TOKEN=""
VITE_BETTER_STACK_INGESTING_HOST="https://in.logs.betterstack.com"

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render Deployment)
# ------------------------------------------------------------------------------
# PORT: HTTP server port (Render assigns automatically via $PORT)
PORT=3000

# CLIENT_URL: Allowed CORS origin for the Vercel frontend (e.g., https://sahachara.vercel.app)
CLIENT_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Service role secret key for backend database bypass / admin tasks
SUPABASE_SERVICE_ROLE_KEY=""

# DATABASE_URL: PostgreSQL connection string from Supabase (postgres://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres)
DATABASE_URL=""

# Backend APM: New Relic Node.js Agent
NEW_RELIC_LICENSE_KEY=""
NEW_RELIC_APP_NAME="Sahachara Ops Backend (Production)"
NEW_RELIC_ENABLED="true"

# Backend Structured Logging: Better Stack Logs (Logtail)
BETTER_STACK_SOURCE_TOKEN=""
BETTER_STACK_INGESTING_HOST="https://in.logs.betterstack.com"

# Operational Heartbeat Monitoring: Better Stack Heartbeat Ping URL
BETTER_STACK_HEARTBEAT_URL=""
